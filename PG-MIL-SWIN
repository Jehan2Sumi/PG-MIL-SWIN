def run_one_seed(seed):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"\n==================== SEED {seed} | device={device.type} ====================")
    seed_everything(seed, CFG["DETERMINISTIC"], CFG["DETERMINISTIC_WARN_ONLY"])

    run_dir = os.path.join(CFG["RUN_ROOT"], "runs", f"seed{seed}")
    plots_dir = os.path.join(run_dir, "plots")
    tables_dir = os.path.join(run_dir, "tables")
    ckpt_dir = os.path.join(run_dir, "checkpoints")
    ensure_dir(plots_dir)
    ensure_dir(tables_dir)
    ensure_dir(ckpt_dir)

    done_path = os.path.join(run_dir, "DONE.json")
    if os.path.exists(done_path):
        print("✅ Seed already complete. Reusing DONE.json")
        return jload(done_path)

    df_tr, df_va, df_te = load_split_csvs(CFG["DATA_ROOT"])
    df_tr, df_va, df_te = stable_sort_df(df_tr), stable_sort_df(df_va), stable_sort_df(df_te)

    split_counts = {}
    for name, df in [("train", df_tr), ("val", df_va), ("test", df_te)]:
        split_counts[name] = {
            "slices": int(len(df)),
            "cases": int(df["CASE_ID"].nunique()),
            "per_class_slices": df["Class"].value_counts().reindex(CFG["CLASSES"], fill_value=0).to_dict(),
            "per_class_cases": df.groupby("Class")["CASE_ID"].nunique().reindex(CFG["CLASSES"], fill_value=0).to_dict(),
        }
    jdump(split_counts, os.path.join(run_dir, "data_split_counts.json"))

    ds_tr = TwoPointFiveDDataset(df_tr, CFG["IMG_SIZE"])
    ds_va = TwoPointFiveDDataset(df_va, CFG["IMG_SIZE"])
    ds_te = TwoPointFiveDDataset(df_te, CFG["IMG_SIZE"])

    dl_tr = make_loader(ds_tr, CFG["SLICE_BATCH"], True, seed)
    dl_va = make_loader(ds_va, CFG["SLICE_BATCH"], False, seed)
    dl_te = make_loader(ds_te, CFG["SLICE_BATCH"], False, seed)

    class_weights, class_weight_dict = compute_class_weights(df_tr, device)
    loss_fn = CurriculumFocalLoss(
        class_weights,
        CFG["FOCAL_GAMMA_MAX"],
        CFG["FOCAL_WARMUP_EPOCHS"]
    )

    # ----------------------------- Slice 2.5D Swin ---------------------------
    slice_model, backbone_used = build_classifier(CFG["BACKBONE"], len(CFG["CLASSES"]))
    slice_model.to(device)

    opt = torch.optim.AdamW(
        slice_model.parameters(),
        lr=CFG["SLICE_LR"],
        weight_decay=CFG["WEIGHT_DECAY"]
    )

    scaler = GradScaler(enabled=(CFG["AMP_SLICE"] and device.type == "cuda"))

    ckpt_best = os.path.join(ckpt_dir, "slice_best.pt")
    ckpt_last = os.path.join(ckpt_dir, "slice_last.pt")
    hist_path = os.path.join(run_dir, "slice_training_history.json")
    slice_stage_done = os.path.join(run_dir, "SLICE_STAGE_DONE.json")

    history = safe_jload(hist_path, default=None)
    if not isinstance(history, dict):
        history = {
            "seed": seed,
            "backbone_used": backbone_used,
            "loss": "curriculum_focal" if CFG["USE_CURRICULUM_FOCAL"] else "cross_entropy",
            "class_weights": class_weight_dict,
            "epochs": [],
        }

    best_val, bad_epochs, start_ep = -1.0, 0, 1

    if CFG.get("RESUME_TRAINING", True) and os.path.exists(slice_stage_done) and os.path.exists(ckpt_best):
        stage_info = safe_jload(slice_stage_done, default={}) or {}
        best_val = float(stage_info.get("best_val_macro_f1", -1.0))
        backbone_used = stage_info.get("backbone_used", backbone_used)
        print(f"✅ Slice stage already complete for seed {seed}; loading best checkpoint.")

    elif CFG.get("RESUME_TRAINING", True) and os.path.exists(ckpt_last):
        try:
            last = safe_torch_load(ckpt_last, map_location="cpu")
            slice_model.load_state_dict(last["model"])

            if "optimizer" in last and last["optimizer"] is not None:
                opt.load_state_dict(last["optimizer"])
                move_optimizer_state_to_device(opt, device)

            if "scaler" in last and last["scaler"] is not None and scaler is not None:
                scaler.load_state_dict(last["scaler"])

            start_ep = int(last.get("epoch", 0)) + 1
            best_val = float(last.get("best_val_macro_f1", -1.0))
            bad_epochs = int(last.get("bad_epochs", 0))
            backbone_used = last.get("backbone_used", backbone_used)

            if "epochs" in history:
                history["epochs"] = [
                    e for e in history["epochs"]
                    if int(e.get("epoch", 0)) < start_ep
                ]

            print(
                f"🔁 Resuming slice training for seed {seed} "
                f"from epoch {start_ep}/{CFG['SLICE_EPOCHS']} | best_val={best_val:.4f}"
            )

        except Exception as e:
            print(f"⚠️ Could not resume slice checkpoint; restarting slice training. Reason: {e}")
            best_val, bad_epochs, start_ep = -1.0, 0, 1

    if not (os.path.exists(slice_stage_done) and os.path.exists(ckpt_best)):
        for ep in range(start_ep, CFG["SLICE_EPOCHS"] + 1):
            train_loss, gamma = train_slice_one_epoch(
                slice_model,
                dl_tr,
                opt,
                scaler,
                loss_fn,
                device,
                ep
            )

            va_out = eval_slice_model(slice_model, dl_va, device)
            va_metrics = metrics_from_probs(va_out["y"], va_out["p"], CFG["CLASSES"])
            val_macro_f1 = va_metrics["macro_f1"]

            history["epochs"].append({
                "epoch": ep,
                "train_loss": float(train_loss),
                "val_macro_f1": float(val_macro_f1),
                "val_balanced_accuracy": float(va_metrics["balanced_accuracy"]),
                "curriculum_gamma": float(gamma),
            })

            jdump(history, hist_path)

            print(
                f"[seed{seed}] Slice ep{ep:02d} "
                f"loss={train_loss:.4f} val_macroF1={val_macro_f1:.4f} gamma={gamma:.3f}"
            )

            is_best = val_macro_f1 > best_val

            if is_best:
                best_val = val_macro_f1
                bad_epochs = 0
            else:
                bad_epochs += 1

            if CFG.get("SAVE_LAST_EVERY_EPOCH", True):
                torch.save({
                    "epoch": ep,
                    "model": slice_model.state_dict(),
                    "optimizer": opt.state_dict(),
                    "scaler": scaler.state_dict() if scaler is not None else None,
                    "best_val_macro_f1": best_val,
                    "bad_epochs": bad_epochs,
                    "backbone_used": backbone_used,
                }, ckpt_last)

            if is_best:
                shutil.copy2(ckpt_last, ckpt_best)

            if bad_epochs >= CFG["EARLY_STOP_PATIENCE"]:
                print(f"⏹ Early stopping slice model at epoch {ep}")
                break

        if not os.path.exists(ckpt_best) and os.path.exists(ckpt_last):
            shutil.copy2(ckpt_last, ckpt_best)

        jdump({
            "seed": seed,
            "stage": "slice_2p5d_training",
            "status": "complete",
            "best_val_macro_f1": best_val,
            "last_epoch": int(history["epochs"][-1]["epoch"]) if history.get("epochs") else None,
            "backbone_used": backbone_used,
        }, slice_stage_done)

        print("✅ Slice stage checkpoint complete:", slice_stage_done)

    plot_training_curves(history, plots_dir, f"seed{seed}_slice_2p5d")

    best_state = safe_torch_load(ckpt_best, map_location="cpu")
    slice_model.load_state_dict(best_state["model"])
    slice_model.to(device)

    te_out = eval_slice_model(slice_model, dl_te, device)

    slice_metrics, slice_ci = full_eval_and_plots(
        te_out["y"],
        te_out["p"],
        ids=[
            f"{cid}|s{si}"
            for cid, si in zip(te_out["case_ids"], te_out["slice_indices"])
        ],
        paths=te_out["paths"],
        classes=CFG["CLASSES"],
        prefix=f"seed{seed}_slice_2p5d_test",
        run_dir=run_dir,
    )

    # ------------------------- Case mean-prob baseline ------------------------
    case_y, case_p, case_ids = aggregate_case_meanprob(
        te_out["y"],
        te_out["p"],
        te_out["case_ids"],
        CFG["MAX_SLICES_EVAL"],
        seed
    )

    case_mean_metrics, case_mean_ci = full_eval_and_plots(
        case_y,
        case_p,
        ids=case_ids,
        paths=None,
        classes=CFG["CLASSES"],
        prefix=f"seed{seed}_case_meanprob_test",
        run_dir=run_dir,
    )

    # ------------------------ Proposed Prototype-Guided MIL -------------------
    pgmil_metrics, pgmil_ci = None, None

    if CFG["RUN_PG_MIL"]:
        feat_cache = os.path.join(run_dir, "feature_cache")
        ensure_dir(feat_cache)

        tr_npz = os.path.join(feat_cache, "train_features.npz")
        va_npz = os.path.join(feat_cache, "val_features.npz")
        te_npz = os.path.join(feat_cache, "test_features.npz")
        cache_info_path = os.path.join(feat_cache, "feature_cache_signature.json")

        # Current feature-cache signature.
        # This prevents stale features from being reused after slice_best.pt changes.
        current_sig = feature_cache_signature(ckpt_best, backbone_used)
        feature_paths = [tr_npz, va_npz, te_npz]

        feat_model = build_feature_extractor(backbone_used, ckpt_best, device)
        
        for param in feat_model.parameters():
            param.requires_grad = False

        if feature_cache_valid(cache_info_path, current_sig, feature_paths):
            print("✅ Reusing valid cached features matched to current slice checkpoint.")

            tr_feat = load_feature_npz(tr_npz)
            va_feat = load_feature_npz(va_npz)
            te_feat = load_feature_npz(te_npz)

        else:
            print("⚠️ Feature cache missing or stale.")
            print("🔁 Re-extracting features using current slice_best.pt.")

            for old_p in feature_paths:
                if os.path.exists(old_p):
                    os.remove(old_p)

            print("🔁 Extracting train features...")
            tr_feat = extract_features(feat_model, dl_tr, device)
            save_feature_npz(tr_feat, tr_npz)

            print("🔁 Extracting validation features...")
            va_feat = extract_features(feat_model, dl_va, device)
            save_feature_npz(va_feat, va_npz)

            print("🔁 Extracting test features...")
            te_feat = extract_features(feat_model, dl_te, device)
            save_feature_npz(te_feat, te_npz)

            jdump(current_sig, cache_info_path)
            print("📌 Feature cache signature saved:", cache_info_path)

        in_dim = int(tr_feat["feats"].shape[1])
        print("✅ Feature dimension for PG-MIL:", in_dim)

        ds_tr_bag = BagFeatureDataset(
            tr_feat,
            CFG["MAX_SLICES_TRAIN"],
            seed,
            train=True
        )

        ds_va_bag = BagFeatureDataset(
            va_feat,
            CFG["MAX_SLICES_EVAL"],
            seed,
            train=False
        )

        ds_te_bag = BagFeatureDataset(
            te_feat,
            CFG["MAX_SLICES_EVAL"],
            seed,
            train=False
        )

        dl_tr_bag = make_bag_loader(ds_tr_bag, CFG["CASE_BATCH"], True, seed)
        dl_va_bag = make_bag_loader(ds_va_bag, CFG["CASE_BATCH"], False, seed)
        dl_te_bag = make_bag_loader(ds_te_bag, CFG["CASE_BATCH"], False, seed)

        pgmil = PrototypeGuidedAttentionMIL(
            in_dim=in_dim,
            hidden_dim=CFG["FUSE_D"],
            heads=CFG["FUSE_HEADS"],
            num_classes=len(CFG["CLASSES"]),
            prototypes_per_class=CFG["PROTOTYPES_PER_CLASS"],
            drop=CFG["DROP"],
            proto_logit_scale=CFG["PROTO_LOGIT_SCALE"],
        ).to(device)

        opt_p = torch.optim.AdamW(
            pgmil.parameters(),
            lr=CFG["CASE_LR"],
            weight_decay=CFG["WEIGHT_DECAY"]
        )

        scaler_p = GradScaler(enabled=(CFG["AMP_CASE"] and device.type == "cuda"))

        pg_loss_fn = CurriculumFocalLoss(
            class_weights,
            CFG["FOCAL_GAMMA_MAX"],
            CFG["FOCAL_WARMUP_EPOCHS"]
        )

        pg_best = os.path.join(ckpt_dir, "pgmil_best.pt")
        pg_last = os.path.join(ckpt_dir, "pgmil_last.pt")
        pg_hist_path = os.path.join(run_dir, "pgmil_training_history.json")
        pg_stage_done = os.path.join(run_dir, "PGMIL_STAGE_DONE.json")

        pg_history = safe_jload(pg_hist_path, default=None)
        if not isinstance(pg_history, dict):
            pg_history = {"seed": seed, "epochs": []}

        best_pg, bad_pg, pg_start_ep = -1.0, 0, 1

        if CFG.get("RESUME_TRAINING", True) and os.path.exists(pg_stage_done) and os.path.exists(pg_best):
            stage_info = safe_jload(pg_stage_done, default={}) or {}
            best_pg = float(stage_info.get("best_val_macro_f1", -1.0))
            print(f"✅ PG-MIL stage already complete for seed {seed}; loading best checkpoint.")

        elif CFG.get("RESUME_TRAINING", True) and os.path.exists(pg_last):
            try:
                last = safe_torch_load(pg_last, map_location="cpu")
                pgmil.load_state_dict(last["model"])

                if "optimizer" in last and last["optimizer"] is not None:
                    opt_p.load_state_dict(last["optimizer"])
                    move_optimizer_state_to_device(opt_p, device)

                if "scaler" in last and last["scaler"] is not None and scaler_p is not None:
                    scaler_p.load_state_dict(last["scaler"])

                pg_start_ep = int(last.get("epoch", 0)) + 1
                best_pg = float(last.get("best_val_macro_f1", -1.0))
                bad_pg = int(last.get("bad_epochs", 0))

                if "epochs" in pg_history:
                    pg_history["epochs"] = [
                        e for e in pg_history["epochs"]
                        if int(e.get("epoch", 0)) < pg_start_ep
                    ]

                print(
                    f"🔁 Resuming PG-MIL training for seed {seed} "
                    f"from epoch {pg_start_ep}/{CFG['CASE_EPOCHS']} | best_val={best_pg:.4f}"
                )

            except Exception as e:
                print(f"⚠️ Could not resume PG-MIL checkpoint; restarting PG-MIL training. Reason: {e}")
                best_pg, bad_pg, pg_start_ep = -1.0, 0, 1

        if not (os.path.exists(pg_stage_done) and os.path.exists(pg_best)):
            for ep in range(pg_start_ep, CFG["CASE_EPOCHS"] + 1):
                ds_tr_bag.set_epoch(ep)

                tr_bag = run_pg_mil_epoch(
                    pgmil,
                    dl_tr_bag,
                    opt_p,
                    scaler_p,
                    pg_loss_fn,
                    device,
                    ep,
                    train=True
                )

                va_bag = run_pg_mil_epoch(
                    pgmil,
                    dl_va_bag,
                    None,
                    None,
                    pg_loss_fn,
                    device,
                    ep,
                    train=False
                )

                va_pg_metrics = metrics_from_probs(
                    va_bag["y"],
                    va_bag["p"],
                    CFG["CLASSES"]
                )

                val_f1 = va_pg_metrics["macro_f1"]

                pg_history["epochs"].append({
                    "epoch": ep,
                    "train_loss": float(tr_bag["loss"]),
                    "val_macro_f1": float(val_f1),
                    "val_balanced_accuracy": float(va_pg_metrics["balanced_accuracy"]),
                    "curriculum_gamma": float(tr_bag["gamma"]),
                })

                jdump(pg_history, pg_hist_path)

                print(
                    f"[seed{seed}] PG-MIL ep{ep:02d} "
                    f"loss={tr_bag['loss']:.4f} val_macroF1={val_f1:.4f}"
                )

                is_best_pg = val_f1 > best_pg

                if is_best_pg:
                    best_pg = val_f1
                    bad_pg = 0
                else:
                    bad_pg += 1

                if CFG.get("SAVE_LAST_EVERY_EPOCH", True):
                    torch.save({
                        "epoch": ep,
                        "model": pgmil.state_dict(),
                        "optimizer": opt_p.state_dict(),
                        "scaler": scaler_p.state_dict() if scaler_p is not None else None,
                        "best_val_macro_f1": best_pg,
                        "bad_epochs": bad_pg,
                        "in_dim": in_dim,
                    }, pg_last)

                if is_best_pg:
                    shutil.copy2(pg_last, pg_best)

                if bad_pg >= CFG["MIL_EARLY_STOP_PATIENCE"]:
                    print(f"⏹ Early stopping PG-MIL at epoch {ep}")
                    break

            if not os.path.exists(pg_best) and os.path.exists(pg_last):
                shutil.copy2(pg_last, pg_best)

            jdump({
                "seed": seed,
                "stage": "pgmil_case_training",
                "status": "complete",
                "best_val_macro_f1": best_pg,
                "last_epoch": int(pg_history["epochs"][-1]["epoch"]) if pg_history.get("epochs") else None,
                "in_dim": in_dim,
            }, pg_stage_done)

            print("✅ PG-MIL stage checkpoint complete:", pg_stage_done)

        plot_training_curves(pg_history, plots_dir, f"seed{seed}_pgmil_case")

        pg_state = safe_torch_load(pg_best, map_location="cpu")
        pgmil.load_state_dict(pg_state["model"])
        pgmil.to(device)

        te_bag = run_pg_mil_epoch(
            pgmil,
            dl_te_bag,
            None,
            None,
            pg_loss_fn,
            device,
            999,
            train=False
        )

        pg_prefix = f"seed{seed}_proposed_pgmil_case_test"

        pgmil_metrics, pgmil_ci = full_eval_and_plots(
            te_bag["y"],
            te_bag["p"],
            ids=te_bag["case_ids"],
            paths=None,
            classes=CFG["CLASSES"],
            prefix=pg_prefix,
            run_dir=run_dir,
        )

        attn_csv = os.path.join(tables_dir, f"{pg_prefix}_attention_weights.csv")
        proto_csv = os.path.join(tables_dir, f"{pg_prefix}_prototype_similarities.csv")

        attn_df = pd.DataFrame(te_bag["attn_rows"])
        proto_df = pd.DataFrame(te_bag["proto_rows"])

        if not attn_df.empty:
            attn_df = attn_df.sort_values(
                ["CASE_ID", "Attention_Weight"],
                ascending=[True, False]
            )

            attn_df.to_csv(attn_csv, index=False)

            attn_df.groupby("CASE_ID").head(5).reset_index(drop=True).to_csv(
                os.path.join(tables_dir, f"{pg_prefix}_top5_attended_slices.csv"),
                index=False
            )

            plot_top_attention(attn_csv, plots_dir, top_cases=6)

        if not proto_df.empty:
            proto_df.to_csv(proto_csv, index=False)

            proto_df.sort_values(
                ["CASE_ID", "Similarity"],
                ascending=[True, False]
            ).groupby("CASE_ID").head(6).reset_index(drop=True).to_csv(
                os.path.join(tables_dir, f"{pg_prefix}_top_prototype_matches.csv"),
                index=False
            )

            plot_prototype_summary(proto_csv, plots_dir, pg_prefix)

    summary = {
        "seed": seed,
        "backbone_used": backbone_used,

        "slice_2p5d_test_macro_f1": slice_metrics["macro_f1"],
        "slice_2p5d_test_balanced_accuracy": slice_metrics["balanced_accuracy"],
        "slice_2p5d_test_auc_ovr_macro": slice_metrics["auc_ovr_macro"],

        "case_meanprob_test_macro_f1": case_mean_metrics["macro_f1"],
        "case_meanprob_test_balanced_accuracy": case_mean_metrics["balanced_accuracy"],
        "case_meanprob_test_auc_ovr_macro": case_mean_metrics["auc_ovr_macro"],

        "proposed_pgmil_case_test_macro_f1": pgmil_metrics["macro_f1"] if pgmil_metrics else None,
        "proposed_pgmil_case_test_balanced_accuracy": pgmil_metrics["balanced_accuracy"] if pgmil_metrics else None,
        "proposed_pgmil_case_test_auc_ovr_macro": pgmil_metrics["auc_ovr_macro"] if pgmil_metrics else None,
        "proposed_pgmil_case_test_mcc": pgmil_metrics["mcc"] if pgmil_metrics else None,
        "proposed_pgmil_case_test_kappa": pgmil_metrics["cohen_kappa"] if pgmil_metrics else None,

        "case_meanprob_ci95": case_mean_ci,
        "proposed_pgmil_ci95": pgmil_ci,
    }

    jdump(summary, done_path)
    print("✅ Seed complete:", done_path)

    return summary

