def export_prediction_table(y, p, ids, paths, classes, out_csv):
    pred = p.argmax(axis=1)
    rows = []
    for i in range(len(y)):
        row = {
            "ID": ids[i],
            "True_Label": classes[int(y[i])],
            "Pred_Label": classes[int(pred[i])],
            "Correct": int(pred[i] == y[i]),
            "Confidence": float(p[i, pred[i]]),
        }
        if paths is not None:
            row["Image_Path"] = paths[i]
        for j, c in enumerate(classes):
            row[f"Prob_{c}"] = float(p[i, j])
        rows.append(row)
    df = pd.DataFrame(rows)
    ensure_dir(os.path.dirname(out_csv))
    df.to_csv(out_csv, index=False)
    return df


