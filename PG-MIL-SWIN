def resolve_backbone(name):
    """Resolve a timm model name without triggering Hugging Face downloads."""
    models = timm.list_models(pretrained=False)

    if name in models:
        return name

    # Use architecture-only model names first. Avoid *.ms_in1k names when offline.
    aliases = [
        name,
        "swin_tiny_patch4_window7_224",
        "convnext_tiny",
        "resnet50",
    ]

    for m in aliases:
        if m in models:
            print(f"⚠️ Backbone resolved: requested={name} → used={m}")
            return m

    for key in ["swin_tiny", "swin", "convnext", "resnet50"]:
        cand = [m for m in models if key in m]
        if cand:
            print(f"⚠️ Backbone resolved by keyword: requested={name} → used={cand[0]}")
            return cand[0]

    raise RuntimeError(f"No compatible timm backbone found for: {name}")


def build_classifier(backbone_name, num_classes):
    resolved = resolve_backbone(backbone_name)
    use_pretrained = bool(CFG.get("USE_PRETRAINED_BACKBONE", False))
    try:
        model = timm.create_model(resolved, pretrained=use_pretrained, num_classes=num_classes)
        print(f"✅ Created backbone: {resolved} | pretrained={use_pretrained}")
    except Exception as e:
        if use_pretrained:
            print(f"⚠️ Pretrained download/load failed for {resolved}: {e}")
            print("⚠️ Falling back to pretrained=False so Kaggle offline run can continue.")
            model = timm.create_model(resolved, pretrained=False, num_classes=num_classes)
        else:
            raise
    return model, resolved


