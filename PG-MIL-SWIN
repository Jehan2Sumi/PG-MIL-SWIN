def seed_everything(seed: int, deterministic: bool = True, warn_only: bool = True):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

    if deterministic:
        torch.backends.cudnn.benchmark = False
        torch.backends.cudnn.deterministic = True
        try:
            torch.use_deterministic_algorithms(True, warn_only=warn_only)
        except TypeError:
            torch.use_deterministic_algorithms(True)


def ensure_dir(path: str):
    if path:
        os.makedirs(path, exist_ok=True)


def jdump(obj, path: str):
    ensure_dir(os.path.dirname(path))
    with open(path, "w") as f:
        json.dump(obj, f, indent=2)


def jload(path: str):
    with open(path, "r") as f:
        return json.load(f)


def safe_jload(path: str, default=None):
    if not os.path.exists(path):
        return default
    try:
        return jload(path)
    except Exception as e:
        print(f"⚠️ Could not read JSON {path}: {e}")
        return default


def safe_torch_load(path: str, map_location="cpu"):
    """Torch loader compatible with different PyTorch versions."""
    try:
        return torch.load(path, map_location=map_location, weights_only=False)
    except TypeError:
        return torch.load(path, map_location=map_location)


