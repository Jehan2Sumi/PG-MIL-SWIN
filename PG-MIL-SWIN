def file_sha1(path: str, block_size: int = 1024 * 1024) -> str:
    """Compute SHA1 hash of a file for checkpoint-cache consistency."""
    h = hashlib.sha1()

    with open(path, "rb") as f:
        while True:
            block = f.read(block_size)
            if not block:
                break
            h.update(block)

    return h.hexdigest()


def feature_cache_signature(ckpt_best: str, backbone_used: str) -> Dict:
    """
    Create a signature describing the exact slice checkpoint/config
    used for feature extraction.

    Cached train/val/test features are reused only if this signature matches.
    """
    return {
        "slice_checkpoint_path": str(ckpt_best),
        "slice_checkpoint_sha1": file_sha1(ckpt_best) if os.path.exists(ckpt_best) else None,
        "backbone_used": str(backbone_used),
        "img_size": int(CFG["IMG_SIZE"]),
        "use_2p5d_metadata": bool(CFG["USE_2P5D_METADATA"]),
        "use_grayscale_2p5d": bool(CFG["USE_GRAYSCALE_2P5D"]),
        "norm_mode": str(CFG["NORM_MODE"]),
        "classes": list(CFG["CLASSES"]),
    }


def feature_cache_valid(cache_info_path: str, current_sig: Dict, feature_paths: List[str]) -> bool:
    """
    Return True only when all cached feature files exist and match the
    current slice checkpoint/config signature.
    """
    if not all(os.path.exists(p) for p in feature_paths):
        return False

    old_sig = safe_jload(cache_info_path, default=None)

    if not isinstance(old_sig, dict):
        return False

    return old_sig == current_sig


def move_optimizer_state_to_device(optimizer, device):
    """After loading an optimizer checkpoint, move its state tensors to the active device."""
    if optimizer is None:
        return

    for state in optimizer.state.values():
        for k, v in state.items():
            if torch.is_tensor(v):
                state[k] = v.to(device)


