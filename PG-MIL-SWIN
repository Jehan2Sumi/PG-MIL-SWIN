def plot_confusion(cm, classes, title, out_png, normalize=False):
    if normalize:
        mat = cm / np.clip(cm.sum(axis=1, keepdims=True), 1, None)
        fmt = "{:.2f}"
        label = "Proportion"
    else:
        mat = cm
        fmt = "{:d}"
        label = "Count"

    plt.figure(figsize=(6, 5))
    im = plt.imshow(mat, cmap=CFG["CMAP"])
    plt.title(title)
    plt.xlabel("Predicted class")
    plt.ylabel("True class")
    plt.xticks(range(len(classes)), classes)
    plt.yticks(range(len(classes)), classes)
    cbar = plt.colorbar(im)
    cbar.set_label(label)

    max_val = mat.max() if mat.size else 0
    for i in range(mat.shape[0]):
        for j in range(mat.shape[1]):
            val = mat[i, j]
            text = fmt.format(val) if normalize else fmt.format(int(val))
            plt.text(j, i, text, ha="center", va="center", fontsize=10,
                     color="white" if max_val > 0 and val > max_val * 0.6 else "black")

    plt.tight_layout()
    savefig(out_png)
    plt.show()


def plot_roc_pr(y, p, classes, prefix, out_dir):
    y_oh = onehot(y, len(classes))

    plt.figure(figsize=(6, 5))
    for i, c in enumerate(classes):
        if len(np.unique(y_oh[:, i])) < 2:
            continue
        fpr, tpr, _ = roc_curve(y_oh[:, i], p[:, i])
        auc_i = roc_auc_score(y_oh[:, i], p[:, i])
        plt.plot(fpr, tpr, label=f"{c} AUC={auc_i:.3f}")
    plt.plot([0, 1], [0, 1], linestyle="--", label="Chance")
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.title(f"{prefix} — ROC")
    plt.legend()
    plt.tight_layout()
    savefig(os.path.join(out_dir, f"{prefix}_roc_1000dpi.png"))
    plt.show()

    plt.figure(figsize=(6, 5))
    for i, c in enumerate(classes):
        if len(np.unique(y_oh[:, i])) < 2:
            continue
        prec, rec, _ = precision_recall_curve(y_oh[:, i], p[:, i])
        ap_i = average_precision_score(y_oh[:, i], p[:, i])
        plt.plot(rec, prec, label=f"{c} AP={ap_i:.3f}")
    plt.xlabel("Recall")
    plt.ylabel("Precision")
    plt.title(f"{prefix} — Precision-Recall")
    plt.legend()
    plt.tight_layout()
    savefig(os.path.join(out_dir, f"{prefix}_pr_1000dpi.png"))
    plt.show()


def plot_reliability(y, p, prefix, out_dir):
    conf = p.max(axis=1)
    pred = p.argmax(axis=1)
    correct = (pred == y).astype(np.float32)
    bins = CFG["ECE_BINS"]
    edges = np.linspace(0.0, 1.0, bins + 1)

    bin_acc, bin_conf = [], []
    for i in range(bins):
        lo, hi = edges[i], edges[i + 1]
        mask = (conf >= lo) & (conf < hi) if i < bins - 1 else (conf >= lo) & (conf <= hi)
        if np.any(mask):
            bin_acc.append(float(correct[mask].mean()))
            bin_conf.append(float(conf[mask].mean()))
        else:
            bin_acc.append(np.nan)
            bin_conf.append((lo + hi) / 2)

    ece, mce = compute_ece(conf, correct, bins=bins)

    plt.figure(figsize=(6, 5))
    plt.plot([0, 1], [0, 1], linestyle="--", label="Ideal")
    plt.plot(bin_conf, bin_acc, marker="o", label=f"Model ECE={ece:.3f}, MCE={mce:.3f}")
