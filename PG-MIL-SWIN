def summarize_across_seeds(summary_df, out_dir):
    key_cols = [
        "slice_2p5d_test_macro_f1",
        "case_meanprob_test_macro_f1",
        "proposed_pgmil_case_test_macro_f1",
        "proposed_pgmil_case_test_balanced_accuracy",
        "proposed_pgmil_case_test_auc_ovr_macro",
        "proposed_pgmil_case_test_mcc",
        "proposed_pgmil_case_test_kappa",
    ]
    rows = []
    for col in key_cols:
        if col not in summary_df.columns:
            continue
        vals = pd.to_numeric(summary_df[col], errors="coerce").dropna().values
        if len(vals) == 0:
            continue
        rows.append({
            "Metric": col,
            "Mean": float(np.mean(vals)),
            "Std": float(np.std(vals, ddof=1)) if len(vals) > 1 else 0.0,
            "Min": float(np.min(vals)),
            "Max": float(np.max(vals)),
            "N_Seeds": int(len(vals)),
        })
    out = pd.DataFrame(rows)
    out_csv = os.path.join(out_dir, "cross_seed_mean_std_metrics.csv")
    out.to_csv(out_csv, index=False)
    print("📌 Cross-seed mean±SD saved:", out_csv)

    available = [c for c in key_cols if c in summary_df.columns]
    plot_data, labels = [], []
    for c in available:
        vals = pd.to_numeric(summary_df[c], errors="coerce").dropna().values
        if len(vals) > 0:
            plot_data.append(vals)
            labels.append(c.replace("proposed_pgmil_case_test_", "PGMIL_").replace("case_meanprob_test_", "MeanProb_").replace("slice_2p5d_test_", "Slice_"))
    if plot_data:
        plt.figure(figsize=(max(8, len(labels) * 1.4), 5))
        plt.boxplot(plot_data, labels=labels, showmeans=True)
        plt.xticks(rotation=45, ha="right")
        plt.ylabel("Score")
        plt.title("Cross-seed performance distribution")
        plt.tight_layout()
        savefig(os.path.join(out_dir, "cross_seed_metric_boxplot_1000dpi.png"))
        plt.show()
    return out


def write_methods_and_results_snippets(run_root, best_seed, cross_seed_df):
    paper_dir = os.path.join(run_root, "paper_package")
    ensure_dir(paper_dir)

    methods = f"""
A classification-only prototype-guided 2.5D attention multi-instance transformer was developed for CHCC, HCC, and ICC classification from uncropped abdominal CT images. For each center slice, the previous, current, and next slices were stacked as a 2.5D input and processed using a Swin Transformer backbone. When internet access is unavailable, the backbone is initialized without external pretrained weights to keep the experiment fully runnable in an offline Kaggle environment. A difficulty-aware curriculum focal loss was used during training, gradually increasing emphasis on harder examples. Case-level diagnosis was obtained using an attention-based multi-instance learning module that aggregated slice-level features within each patient/case. To improve interpretability, class-associated learnable prototypes were integrated at the case-representation level, allowing the model to report prototype similarities and top-attended slices for each test case. No liver or tumour segmentation and no external detection/cropping model was used.

Evaluation was performed at slice level, case-level mean-probability aggregation level, and proposed prototype-guided MIL case level. Metrics included accuracy, balanced accuracy, macro/weighted/micro F1, macro precision, macro recall, class-wise sensitivity, specificity, precision/PPV, NPV, AUROC, AUPRC/AP, MCC, Cohen's kappa, log loss, Brier score, ECE, MCE, and bootstrap 95% confidence intervals. Plots were saved at {CFG['DPI_SAVE']} DPI. Experiments were repeated across seeds {CFG['SEEDS']}.
""".strip()
    with open(os.path.join(paper_dir, "methods_sectionB_snippet.txt"), "w") as f:
        f.write(methods)

    lines = []
    if not cross_seed_df.empty:
        for _, r in cross_seed_df.iterrows():
            lines.append(f"{r['Metric']}: {r['Mean']:.4f} ± {r['Std']:.4f} across {int(r['N_Seeds'])} seeds; range {r['Min']:.4f}–{r['Max']:.4f}.")
    with open(os.path.join(paper_dir, "results_sectionB_cross_seed_snippet.txt"), "w") as f:
        f.write("\n".join(lines))
    jdump({"best_seed": int(best_seed), "seeds": CFG["SEEDS"]}, os.path.join(paper_dir, "best_seed.json"))


def make_paper_package(run_root, best_seed):
    paper_dir = os.path.join(run_root, "paper_package")
    fig_dir = os.path.join(paper_dir, "figures_1000dpi")
    tab_dir = os.path.join(paper_dir, "tables")
    metrics_dir = os.path.join(paper_dir, "metrics_json")
    ensure_dir(fig_dir)
    ensure_dir(tab_dir)
    ensure_dir(metrics_dir)

    for fn in ["summary_all_seeds.csv", "cross_seed_mean_std_metrics.csv"]:
        src = os.path.join(run_root, fn)
        if os.path.exists(src):
            shutil.copy2(src, os.path.join(tab_dir, fn))

    best_run = os.path.join(run_root, "runs", f"seed{best_seed}")
    for root, _, files in os.walk(best_run):
        for fn in files:
            src = os.path.join(root, fn)
            if fn.lower().endswith(".png"):
                shutil.copy2(src, os.path.join(fig_dir, f"seed{best_seed}_" + fn))
            elif fn.lower().endswith((".csv", ".txt")):
                shutil.copy2(src, os.path.join(tab_dir, f"seed{best_seed}_" + fn))
            elif fn.lower().endswith(".json"):
                shutil.copy2(src, os.path.join(metrics_dir, f"seed{best_seed}_" + fn))

    fig_rows = []
    for fn in sorted(os.listdir(fig_dir)):
        fig_rows.append({"Figure_File": fn, "DPI": CFG["DPI_SAVE"], "Suggested_Use": "paper/supplementary"})
    pd.DataFrame(fig_rows).to_csv(os.path.join(paper_dir, "figure_index.csv"), index=False)

    paper_zip = os.path.join(run_root, "PAPER_PACKAGE_1000DPI.zip")
    with zipfile.ZipFile(paper_zip, "w", compression=zipfile.ZIP_DEFLATED) as z:
        for root, _, files in os.walk(paper_dir):
            for fn in files:
                fp = os.path.join(root, fn)
                z.write(fp, arcname=os.path.relpath(fp, paper_dir))
    print("📦 Paper package ZIP:", paper_zip)
    return paper_zip


def make_full_results_zip(run_root):
    zip_path = os.path.join(run_root, "FULL_SECTION_B_RESULTS.zip")
    with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as z:
        for root, _, files in os.walk(run_root):
            for fn in files:
                if fn.endswith(".zip"):
                    continue
                if not CFG["ZIP_INCLUDE_CHECKPOINTS"] and fn.endswith(".pt"):
                    continue
                fp = os.path.join(root, fn)
                z.write(fp, arcname=os.path.relpath(fp, run_root))
    print("📦 Full results ZIP:", zip_path)
    return zip_path


