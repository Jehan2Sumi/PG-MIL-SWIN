class BagFeatureDataset(Dataset):
    def __init__(self, feat_obj, max_slices, seed, train):
        self.feats = feat_obj["feats"]
        self.y = feat_obj["y"]
        self.case_ids = [str(c) for c in feat_obj["case_ids"]]
        self.paths = feat_obj["paths"]
        self.slice_indices = feat_obj["slice_indices"]
        self.max_slices = max_slices
        self.seed = seed
        self.train = train
        self.epoch = 0
        self.case_map = defaultdict(list)
        for i, cid in enumerate(self.case_ids):
            self.case_map[cid].append(i)
        self.cases = sorted(self.case_map.keys())

    def set_epoch(self, epoch):
        self.epoch = epoch

    def __len__(self):
        return len(self.cases)

    def __getitem__(self, idx):
        cid = self.cases[idx]
        idxs = self.case_map[cid]
        idxs = sorted(idxs, key=lambda i: self.slice_indices[i])
        y_case = int(np.bincount(self.y[idxs]).argmax())

        rng = np.random.RandomState(self.seed + self.epoch * 1000 + idx)
        if self.train and len(idxs) > self.max_slices:
            idxs = list(rng.choice(idxs, size=self.max_slices, replace=False))
            idxs = sorted(idxs, key=lambda i: self.slice_indices[i])
        elif len(idxs) > self.max_slices:
            start = max(0, (len(idxs) - self.max_slices) // 2)
            idxs = idxs[start:start + self.max_slices]

        x = self.feats[idxs]
        paths = [self.paths[i] for i in idxs]
        slice_idxs = [int(self.slice_indices[i]) for i in idxs]
        return torch.from_numpy(x).float(), y_case, cid, paths, slice_idxs


def pad_collate_bags(batch):
    xs, ys, cids, paths_list, sliceidx_list = zip(*batch)
    lens = [x.shape[0] for x in xs]
    max_len = max(lens)
    d = xs[0].shape[1]
    X = torch.zeros((len(xs), max_len, d), dtype=torch.float32)
    pad_mask = torch.ones((len(xs), max_len), dtype=torch.bool)
    for i, x in enumerate(xs):
        t = x.shape[0]
        X[i, :t] = x
        pad_mask[i, :t] = False
    Y = torch.tensor(ys, dtype=torch.long)
    return X, Y, list(cids), list(paths_list), list(sliceidx_list), pad_mask


def make_bag_loader(ds, batch_size, shuffle, seed):
    g = torch.Generator()
    g.manual_seed(seed)
    return DataLoader(ds, batch_size=batch_size, shuffle=shuffle, num_workers=0, collate_fn=pad_collate_bags, generator=g)


def run_pg_mil_epoch(model, loader, opt, scaler, loss_fn, device, epoch, train):
    model.train() if train else model.eval()
    total_loss, n = 0.0, 0
    all_y, all_p, all_case = [], [], []
    attn_rows, proto_rows = [], []
    gamma_last = 0.0
    skipped = 0

    for X, Y, cids, paths_list, sliceidx_list, pad_mask in loader:
        X = X.to(device, non_blocking=True)
        X = torch.nan_to_num(X, nan=0.0, posinf=10.0, neginf=-10.0)
        Y = Y.to(device, non_blocking=True)
        pad_mask = pad_mask.to(device, non_blocking=True)

        if train:
            opt.zero_grad(set_to_none=True)

        with torch.set_grad_enabled(train):
            with cuda_autocast(enabled=(CFG["AMP_CASE"] and device.type == "cuda")):
                logits, attn, proto_sim, proto_reg = model(X, key_padding_mask=pad_mask, target=Y)
                if not torch.isfinite(logits).all():
                    skipped += 1
                    print(f"⚠️ PG-MIL epoch {epoch}: skipped batch with non-finite logits.")
                    continue
                if CFG["USE_CURRICULUM_FOCAL"]:
                    cls_loss, gamma_last = loss_fn(logits, Y, epoch)
                else:
                    safe_logits = torch.clamp(torch.nan_to_num(logits.float(), nan=0.0, posinf=50.0, neginf=-50.0), -50.0, 50.0)
                    cls_loss = F.cross_entropy(safe_logits, Y, weight=loss_fn.class_weights)
                    gamma_last = 0.0
                loss = cls_loss + torch.nan_to_num(proto_reg, nan=0.0, posinf=0.0, neginf=0.0)

            if train:
                if not torch.isfinite(loss):
                    skipped += 1
                    print(f"⚠️ PG-MIL epoch {epoch}: skipped batch with non-finite loss.")
                    continue
                if CFG["AMP_CASE"] and device.type == "cuda":
                    scaler.scale(loss).backward()
                    scaler.unscale_(opt)
                    torch.nn.utils.clip_grad_norm_(model.parameters(), CFG.get("GRAD_CLIP_NORM", 1.0))
                    scaler.step(opt)
                    scaler.update()
                else:
                    loss.backward()
                    torch.nn.utils.clip_grad_norm_(model.parameters(), CFG.get("GRAD_CLIP_NORM", 1.0))
                    opt.step()

        bs = X.size(0)
        total_loss += float(torch.nan_to_num(loss.detach().cpu(), nan=0.0, posinf=0.0, neginf=0.0)) * bs
        n += bs

        pp = softmax_np(logits.float().detach().cpu().numpy())
        aa = torch.nan_to_num(attn, nan=0.0, posinf=0.0, neginf=0.0).detach().cpu().numpy()
        psim = torch.nan_to_num(proto_sim, nan=0.0, posinf=0.0, neginf=0.0).detach().cpu().numpy()

        all_y.append(Y.detach().cpu().numpy())
        all_p.append(pp)
        all_case += cids

        for b, cid in enumerate(cids):
            valid_len = int((~pad_mask[b]).sum().detach().cpu())
            for j in range(valid_len):
                attn_rows.append({
                    "CASE_ID": cid,
                    "Slice_Index": int(sliceidx_list[b][j]),
                    "Image_Path": paths_list[b][j],
                    "Attention_Weight": float(aa[b, j]),
                })
            for ci, cls in enumerate(CFG["CLASSES"]):
                for pi in range(CFG["PROTOTYPES_PER_CLASS"]):
                    proto_rows.append({
                        "CASE_ID": cid,
                        "Class_Prototype": cls,
                        "Prototype_Index": int(pi),
                        "Similarity": float(psim[b, ci, pi]),
                    })

    if skipped > 0:
        print(f"⚠️ PG-MIL epoch {epoch}: skipped {skipped} unstable batches.")

    p_out = sanitize_probs_np(np.vstack(all_p), len(CFG["CLASSES"]), "run_pg_mil_epoch") if all_p else np.empty((0, len(CFG["CLASSES"])))
    return {
        "loss": total_loss / max(1, n),
        "y": np.concatenate(all_y) if all_y else np.array([]),
        "p": p_out,
        "case_ids": all_case,
        "attn_rows": attn_rows,
        "proto_rows": proto_rows,
        "gamma": float(gamma_last),
    }



