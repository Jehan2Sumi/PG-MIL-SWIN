@torch.no_grad()
def extract_features(feat_model, loader, device):
    feat_model.eval()
    feats, ys, cids, paths, slice_indices = [], [], [], [], []
    for x, y, cid, path, slice_idx in loader:
        x = x.to(device, non_blocking=True)
        x = torch.nan_to_num(x, nan=0.0, posinf=5.0, neginf=-5.0)
        f = feat_model(x).float().detach().cpu().numpy()
        if not np.all(np.isfinite(f)):
            print("⚠️ extract_features: non-finite features replaced with zero.")
            f = np.nan_to_num(f, nan=0.0, posinf=0.0, neginf=0.0)
        feats.append(f.astype(np.float32))
        ys.append(np.asarray(y, dtype=np.int64))
        cids += list(cid)
        paths += list(path)
        slice_indices += [int(s) for s in slice_idx]
    return {
        "feats": np.vstack(feats).astype(np.float32),
        "y": np.concatenate(ys),
        "case_ids": cids,
        "paths": paths,
        "slice_indices": slice_indices,
    }



