def plot_decision_curve_ovr(y, p, classes, prefix, out_dir):
    y_oh = onehot(y, len(classes))
    thresholds = np.linspace(0.01, 0.99, 99)

    plt.figure(figsize=(7, 5))
    for i, c in enumerate(classes):
        yt = y_oh[:, i].astype(int)
        pt = p[:, i]
        nb = []
        n = len(yt)
        for t in thresholds:
            pred_pos = (pt >= t).astype(int)
            tp = np.sum((pred_pos == 1) & (yt == 1))
            fp = np.sum((pred_pos == 1) & (yt == 0))
            nb.append((tp / n) - (fp / n) * (t / (1 - t)))
        plt.plot(thresholds, nb, label=c)

    plt.plot(thresholds, np.zeros_like(thresholds), linestyle="--", label="Treat none")
    prev = y_oh.mean(axis=0)
    nb_all_macro = []
    for t in thresholds:
        vals = [pi - (1 - pi) * (t / (1 - t)) for pi in prev]
        nb_all_macro.append(np.mean(vals))
    plt.plot(thresholds, nb_all_macro, linestyle=":", label="Treat all macro")
    plt.xlabel("Threshold probability")
    plt.ylabel("Net benefit")
    plt.title(f"{prefix} — Decision curve")
    plt.legend()
    plt.tight_layout()
    savefig(os.path.join(out_dir, f"{prefix}_decision_curve_1000dpi.png"))
    plt.show()


