def compute_ece(conf: np.ndarray, correct: np.ndarray, bins: int = 10) -> Tuple[float, float]:
    edges = np.linspace(0.0, 1.0, bins + 1)
    ece = 0.0
    mce = 0.0
    n = max(1, len(conf))

    for i in range(bins):
        lo, hi = edges[i], edges[i + 1]
        mask = (conf >= lo) & (conf < hi) if i < bins - 1 else (conf >= lo) & (conf <= hi)
        if not np.any(mask):
            continue
        acc = correct[mask].mean()
        c = conf[mask].mean()
        gap = abs(acc - c)
        ece += (mask.sum() / n) * gap
        mce = max(mce, gap)

    return float(ece), float(mce)


def brier_multiclass(y_oh: np.ndarray, p: np.ndarray) -> float:
    return float(np.mean(np.sum((p - y_oh) ** 2, axis=1)))


def safe_auc_ovr(y_oh: np.ndarray, p: np.ndarray) -> Tuple[float, List[float]]:
    per = []
    for i in range(y_oh.shape[1]):
        if len(np.unique(y_oh[:, i])) < 2:
            per.append(np.nan)
        else:
            per.append(float(roc_auc_score(y_oh[:, i], p[:, i])))
    macro = float(np.nanmean(per)) if np.any(~np.isnan(per)) else np.nan
    return macro, per


def safe_ap_ovr(y_oh: np.ndarray, p: np.ndarray) -> Tuple[float, List[float]]:
    per = []
    for i in range(y_oh.shape[1]):
        if len(np.unique(y_oh[:, i])) < 2:
            per.append(np.nan)
        else:
            per.append(float(average_precision_score(y_oh[:, i], p[:, i])))
    macro = float(np.nanmean(per)) if np.any(~np.isnan(per)) else np.nan
    return macro, per


def sens_spec_npv_from_cm(cm: np.ndarray) -> Tuple[List[float], List[float], List[float]]:
    k = cm.shape[0]
    total = cm.sum()
    sens, spec, npv = [], [], []

    for i in range(k):
        tp = cm[i, i]
        fn = cm[i, :].sum() - tp
        fp = cm[:, i].sum() - tp
        tn = total - tp - fn - fp
        sens.append(float(tp / (tp + fn)) if (tp + fn) > 0 else np.nan)
        spec.append(float(tn / (tn + fp)) if (tn + fp) > 0 else np.nan)
        npv.append(float(tn / (tn + fn)) if (tn + fn) > 0 else np.nan)

    return sens, spec, npv


def metrics_from_probs(y: np.ndarray, p: np.ndarray, classes: List[str]) -> Dict:
    y = np.asarray(y, dtype=int).reshape(-1)
    k = len(classes)
    p = sanitize_probs_np(p, num_classes=k, context="metrics_from_probs")

    if len(y) == 0:
        raise ValueError("metrics_from_probs received empty y.")
    if p.shape[0] != len(y):
        raise ValueError(f"metrics_from_probs shape mismatch: len(y)={len(y)}, p.shape={p.shape}")
    if np.any((y < 0) | (y >= k)):
        raise ValueError(f"metrics_from_probs received labels outside [0,{k-1}].")

    pred = p.argmax(axis=1)
    y_oh = onehot(y, k)

    cm = confusion_matrix(y, pred, labels=list(range(k)))
    sens, spec, npv = sens_spec_npv_from_cm(cm)
    pr, rc, f1c, sup = precision_recall_fscore_support(y, pred, labels=list(range(k)), zero_division=0)
    auc_macro, auc_per = safe_auc_ovr(y_oh, p)
    ap_macro, ap_per = safe_ap_ovr(y_oh, p)

    conf = p.max(axis=1)
    correct = (pred == y).astype(np.float32)
    ece, mce = compute_ece(conf, correct, bins=CFG["ECE_BINS"])

    try:
        ll = log_loss(y, p, labels=list(range(k)))
    except Exception:
        ll = np.nan

    out = {
        "n": int(len(y)),
        "accuracy": float(accuracy_score(y, pred)),
        "balanced_accuracy": float(balanced_accuracy_score(y, pred)),
        "macro_precision": float(precision_score(y, pred, average="macro", zero_division=0)),
        "macro_recall": float(recall_score(y, pred, average="macro", zero_division=0)),
        "macro_f1": float(f1_score(y, pred, average="macro", zero_division=0)),
        "weighted_precision": float(precision_score(y, pred, average="weighted", zero_division=0)),
        "weighted_recall": float(recall_score(y, pred, average="weighted", zero_division=0)),
        "weighted_f1": float(f1_score(y, pred, average="weighted", zero_division=0)),
        "micro_f1": float(f1_score(y, pred, average="micro", zero_division=0)),
        "mcc": float(matthews_corrcoef(y, pred)),
        "cohen_kappa": float(cohen_kappa_score(y, pred)),
        "log_loss": finite_float(ll),
        "brier_score": brier_multiclass(y_oh, p),
        "ece": float(ece),
        "mce": float(mce),
        "auc_ovr_macro": finite_float(auc_macro),
        "ap_ovr_macro": finite_float(ap_macro),
        "confusion_matrix": cm.tolist(),
        "per_class": {},
    }

    for i, c in enumerate(classes):
        out["per_class"][c] = {
            "support": int(sup[i]),
            "precision_ppv": float(pr[i]),
            "recall_sensitivity": float(rc[i]),
            "f1": float(f1c[i]),
            "specificity": finite_float(spec[i]),
            "npv": finite_float(npv[i]),
            "auc_ovr": finite_float(auc_per[i]),
            "ap_ovr": finite_float(ap_per[i]),
        }

    return out



