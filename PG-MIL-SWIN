@torch.no_grad()
def eval_slice_model(model, loader, device):
    model.eval()
    all_y, all_p, all_case, all_paths, all_slice_idx = [], [], [], [], []
    for x, y, cid, path, slice_idx in loader:
        x = x.to(device, non_blocking=True)
        x = torch.nan_to_num(x, nan=0.0, posinf=5.0, neginf=-5.0)
        logits = model(x).float().detach().cpu().numpy()
        all_p.append(softmax_np(logits))
        all_y.append(np.asarray(y, dtype=np.int64))
        all_case += list(cid)
        all_paths += list(path)
        all_slice_idx += [int(s) for s in slice_idx]
    return {
        "y": np.concatenate(all_y),
        "p": sanitize_probs_np(np.vstack(all_p), num_classes=len(CFG["CLASSES"]), context="eval_slice_model"),
        "case_ids": all_case,
        "paths": all_paths,
        "slice_indices": all_slice_idx,
    }



def train_slice_one_epoch(model, loader, opt, scaler, loss_fn, device, epoch):
    model.train()
    total_loss, n = 0.0, 0
    gamma_last = 0.0
    skipped = 0

    for x, y, *_ in loader:
        x = x.to(device, non_blocking=True)
        x = torch.nan_to_num(x, nan=0.0, posinf=5.0, neginf=-5.0)
        y = torch.as_tensor(y, dtype=torch.long, device=device)
        opt.zero_grad(set_to_none=True)

        with cuda_autocast(enabled=(CFG["AMP_SLICE"] and device.type == "cuda")):
            logits = model(x)
            if not torch.isfinite(logits).all():
                skipped += 1
                print(f"⚠️ Slice epoch {epoch}: skipped batch with non-finite logits.")
                continue
            if CFG["USE_CURRICULUM_FOCAL"]:
                loss, gamma_last = loss_fn(logits, y, epoch)
            else:
                safe_logits = torch.clamp(torch.nan_to_num(logits.float(), nan=0.0, posinf=50.0, neginf=-50.0), -50.0, 50.0)
                loss = F.cross_entropy(safe_logits, y, weight=loss_fn.class_weights)
                gamma_last = 0.0

        if not torch.isfinite(loss):
            skipped += 1
            print(f"⚠️ Slice epoch {epoch}: skipped batch with non-finite loss.")
            continue

        if CFG["AMP_SLICE"] and device.type == "cuda":
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(model.parameters(), CFG.get("GRAD_CLIP_NORM", 1.0))
            scaler.step(opt)
            scaler.update()
        else:
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), CFG.get("GRAD_CLIP_NORM", 1.0))
            opt.step()

        bs = x.size(0)
        total_loss += float(loss.detach().cpu()) * bs
        n += bs

    if skipped > 0:
        print(f"⚠️ Slice epoch {epoch}: skipped {skipped} unstable batches.")
    return total_loss / max(1, n), float(gamma_last)



def compute_class_weights(df_train, device):
    counts = df_train["Class"].value_counts().reindex(CFG["CLASSES"], fill_value=0).values.astype(np.float32)
    weights = counts.sum() / np.clip(counts, 1, None)
    weights = weights / np.mean(weights)
    d = {c: float(w) for c, w in zip(CFG["CLASSES"], weights)}
    print("✅ Class weights:", d)
    if CFG["USE_CLASS_WEIGHTS"]:
        return torch.tensor(weights, dtype=torch.float32, device=device), d
    return None, d


def aggregate_case_meanprob(slice_y, slice_p, case_ids, max_slices, seed):
    rng = np.random.RandomState(seed)
    slice_y = np.asarray(slice_y, dtype=np.int64)
    slice_p = sanitize_probs_np(slice_p, num_classes=len(CFG["CLASSES"]), context="aggregate_case_meanprob")
    grouped = defaultdict(list)
    for i, cid in enumerate(case_ids):
        grouped[str(cid)].append(i)
    case_y, case_p, case_list = [], [], []
    for cid in sorted(grouped.keys()):
        idxs = grouped[cid]
        y_case = int(np.bincount(slice_y[idxs], minlength=len(CFG["CLASSES"])).argmax())
        if len(idxs) > max_slices:
            idxs = list(rng.choice(idxs, size=max_slices, replace=False))
        pp = slice_p[idxs].mean(axis=0)
        pp = sanitize_probs_np(pp.reshape(1, -1), num_classes=len(CFG["CLASSES"]), context=f"case_meanprob_{cid}")[0]
        case_y.append(y_case)
        case_p.append(pp)
        case_list.append(cid)
    return np.array(case_y, dtype=np.int64), sanitize_probs_np(np.vstack(case_p), len(CFG["CLASSES"]), "case_meanprob_output"), case_list

