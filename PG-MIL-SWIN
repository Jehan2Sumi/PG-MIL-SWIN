def sanitize_probs_np(
    p: np.ndarray,
    num_classes: Optional[int] = None,
    context: str = "probs"
) -> np.ndarray:
    """Return finite, row-normalized probabilities safe for sklearn metrics."""
    p = np.asarray(p, dtype=np.float64)

    if p.ndim == 1:
        p = p.reshape(1, -1)

    if num_classes is None:
        num_classes = p.shape[1]

    eps = float(CFG.get("PROB_EPS", 1e-7))

    bad_before = int(np.size(p) - np.isfinite(p).sum())
    if bad_before > 0:
        print(f"⚠️ {context}: replaced {bad_before} non-finite probability values.")

    p = np.nan_to_num(
        p,
        nan=1.0 / num_classes,
        posinf=1.0 / num_classes,
        neginf=0.0
    )

    p = np.clip(p, eps, 1.0)

    row_sum = p.sum(axis=1, keepdims=True)
    bad_rows = (~np.isfinite(row_sum[:, 0])) | (row_sum[:, 0] <= 0)

    if np.any(bad_rows):
        print(f"⚠️ {context}: reset {int(bad_rows.sum())} bad probability rows to uniform.")
        p[bad_rows, :] = 1.0 / num_classes
        row_sum = p.sum(axis=1, keepdims=True)

    p = p / np.clip(row_sum, eps, None)
    p = np.nan_to_num(
        p,
        nan=1.0 / num_classes,
        posinf=1.0 / num_classes,
        neginf=0.0
    )

    p = p / np.clip(p.sum(axis=1, keepdims=True), eps, None)

    return p.astype(np.float64)


def softmax_np(logits: np.ndarray) -> np.ndarray:
    """Stable softmax that cannot pass NaN/Inf into sklearn."""
    logits = np.asarray(logits, dtype=np.float64)

    if logits.ndim == 1:
        logits = logits.reshape(1, -1)

    bad = int(np.size(logits) - np.isfinite(logits).sum())
    if bad > 0:
        print(f"⚠️ softmax_np: replaced {bad} non-finite logits before softmax.")

    logits = np.nan_to_num(
        logits,
        nan=0.0,
        posinf=50.0,
        neginf=-50.0
    )

    logits = np.clip(logits, -50.0, 50.0)
    logits = logits - logits.max(axis=1, keepdims=True)

    ex = np.exp(logits)
    p = ex / np.clip(ex.sum(axis=1, keepdims=True), 1e-12, None)

    return sanitize_probs_np(
        p,
        num_classes=logits.shape[1],
        context="softmax_np"
    )


def onehot(y: np.ndarray, k: int) -> np.ndarray:
    out = np.zeros((len(y), k), dtype=np.float32)
    out[np.arange(len(y)), y] = 1.0
    return out


def finite_float(x):
    if x is None:
        return None

    try:
        if np.isnan(x) or np.isinf(x):
            return None
    except Exception:
        pass

    return float(x)

