def read_gray_resized(path, img_size):
    im = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)
    if im is None:
        raise RuntimeError(f"Unreadable image: {path}")
    if im.ndim == 2:
        gray = im
    elif im.ndim == 3 and im.shape[2] == 4:
        rgb = cv2.cvtColor(im, cv2.COLOR_BGRA2RGB)
        gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY)
    else:
        rgb = cv2.cvtColor(im, cv2.COLOR_BGR2RGB)
        gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY)
    gray = cv2.resize(gray, (img_size, img_size), interpolation=cv2.INTER_AREA)
    return gray.astype(np.float32) / 255.0


def read_rgb_resized(path, img_size):
    im = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)
    if im is None:
        raise RuntimeError(f"Unreadable image: {path}")
    if im.ndim == 2:
        im = cv2.cvtColor(im, cv2.COLOR_GRAY2RGB)
    elif im.ndim == 3 and im.shape[2] == 4:
        im = cv2.cvtColor(im, cv2.COLOR_BGRA2RGB)
    else:
        im = cv2.cvtColor(im, cv2.COLOR_BGR2RGB)
    im = cv2.resize(im, (img_size, img_size), interpolation=cv2.INTER_AREA)
    return im.astype(np.float32) / 255.0


def row_to_2p5d_tensor(row, img_size):
    prev_p = row.get("Prev_Image_Path", row.get("Image_Path"))
    cen_p = row.get("Center_Image_Path", row.get("Image_Path"))
    next_p = row.get("Next_Image_Path", row.get("Image_Path"))

    if CFG["USE_GRAYSCALE_2P5D"]:
        prev = read_gray_resized(prev_p, img_size)
        cen = read_gray_resized(cen_p, img_size)
        nxt = read_gray_resized(next_p, img_size)
        im = np.stack([prev, cen, nxt], axis=-1)
    else:
        im = read_rgb_resized(cen_p, img_size)

    mean = NORM_MEAN.reshape(1, 1, 3).astype(np.float32)
    std = np.clip(NORM_STD.reshape(1, 1, 3).astype(np.float32), 1e-6, None)
    im = (im.astype(np.float32) - mean) / std
    im = np.nan_to_num(im, nan=0.0, posinf=5.0, neginf=-5.0)
    im = np.clip(im, -8.0, 8.0)
    return torch.from_numpy(im).permute(2, 0, 1).contiguous().float()



