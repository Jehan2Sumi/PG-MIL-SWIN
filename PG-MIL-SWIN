class CurriculumFocalLoss(nn.Module):
    def __init__(self, class_weights=None, gamma_max=2.0, warmup_epochs=8):
        super().__init__()
        if class_weights is not None:
            self.register_buffer("class_weights", class_weights)
        else:
            self.class_weights = None
        self.gamma_max = float(gamma_max)
        self.warmup_epochs = max(1, int(warmup_epochs))

    def forward(self, logits, target, epoch):
        # Clamp before log-softmax to avoid AMP/overflow instability.
        logits = torch.nan_to_num(logits.float(), nan=0.0, posinf=50.0, neginf=-50.0)
        logits = torch.clamp(logits, -50.0, 50.0)

        gamma = self.gamma_max * min(1.0, max(0.0, epoch / self.warmup_epochs))
        logp = F.log_softmax(logits, dim=1)
        p = torch.exp(logp)
        target_logp = logp.gather(1, target.view(-1, 1)).squeeze(1)
        target_p = p.gather(1, target.view(-1, 1)).squeeze(1).clamp(1e-7, 1.0 - 1e-7)
        focal = (1.0 - target_p).pow(gamma)
        loss = -focal * target_logp
        if self.class_weights is not None:
            loss = loss * self.class_weights[target]
        loss = torch.nan_to_num(loss, nan=0.0, posinf=50.0, neginf=0.0)
        return loss.mean(), gamma



class PrototypeGuidedAttentionMIL(nn.Module):
    """
    Case-level attention MIL with class-associated prototypes.

    x: B,T,D slice features
    output:
      logits: fused classifier logits + prototype similarity logits
      attention weights over slices
      prototype similarities per class/prototype
    """
    def __init__(self, in_dim, hidden_dim, heads, num_classes, prototypes_per_class, drop=0.15, proto_logit_scale=1.0):
        super().__init__()
        self.num_classes = num_classes
        self.prototypes_per_class = prototypes_per_class
        self.proto_logit_scale = float(proto_logit_scale)
        self.attn_tau = 0.5

        self.proj = nn.Sequential(
            nn.Linear(in_dim, hidden_dim),
            nn.GELU(),
            nn.Dropout(drop),
        )
        self.self_attn = nn.MultiheadAttention(hidden_dim, heads, dropout=drop, batch_first=True)
        self.score = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, 1),
        )
        self.classifier = nn.Linear(hidden_dim, num_classes)

        self.prototypes = nn.Parameter(torch.randn(num_classes, prototypes_per_class, hidden_dim) * 0.02)

    def forward(self, x, key_padding_mask=None, target=None):
        h = self.proj(x)
        h2, _ = self.self_attn(h, h, h, key_padding_mask=key_padding_mask, need_weights=False)
        h = h + h2

        a = self.score(h).squeeze(-1)

        if key_padding_mask is not None:
            a = a.masked_fill(key_padding_mask, -1e9)

        a_scaled = a / self.attn_tau
        w = torch.softmax(a_scaled, dim=1)
        z = torch.sum(h * w.unsqueeze(-1), dim=1)

        cls_logits = self.classifier(z)

        # Prototype similarities: negative squared distance.
        # z: B,D; prototypes: C,P,D => B,C,P
        z = torch.nan_to_num(z, nan=0.0, posinf=10.0, neginf=-10.0)
        proto = torch.nan_to_num(self.prototypes, nan=0.0, posinf=10.0, neginf=-10.0)
        diff = z[:, None, None, :] - proto[None, :, :, :]
        dist2 = torch.sum(diff * diff, dim=-1).clamp(0.0, 1e4)
        proto_sim = -dist2
        proto_logits = proto_sim.max(dim=2).values
        logits = cls_logits + self.proto_logit_scale * proto_logits
        logits = torch.clamp(torch.nan_to_num(logits.float(), nan=0.0, posinf=50.0, neginf=-50.0), -50.0, 50.0)

        proto_reg = torch.tensor(0.0, device=x.device)
        if target is not None:
            # Cluster: sample should be close to at least one prototype of its own class.
            own_dist = dist2[torch.arange(z.size(0), device=x.device), target, :]
            cluster_loss = own_dist.min(dim=1).values.mean()

            # Separation: class prototypes should not collapse together.
            flat = self.prototypes.reshape(self.num_classes * self.prototypes_per_class, -1)
            pdist = torch.cdist(flat, flat, p=2)
            eye = torch.eye(pdist.shape[0], device=x.device).bool()
            sep_loss = torch.exp(-pdist[~eye]).mean()

            proto_reg = CFG["PROTO_CLUSTER_LAMBDA"] * cluster_loss + CFG["PROTO_SEPARATION_LAMBDA"] * sep_loss

        return logits, w, proto_sim, proto_reg


